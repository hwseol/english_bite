{
  "_comment": "Idiom extraction + Korean translation go through this list, in order. A video is processed start to finish by ONE model; if that model is blocked, the video restarts from the beginning on the next one. No API keys in this file - only the paths of the files that hold them (outside the repository).",

  "router": {
    "base_url": "http://127.0.0.1:3001/v1",
    "key_file": "~/.secrets/freellmapi_key.txt"
  },

  "models": [
    {
      "id": "gpt-oss-120b",
      "via": "router",
      "expect_served_by": "gpt-oss-120b",
      "batch_sentences": 30,
      "max_tokens": 6500,
      "min_interval_s": 60,
      "timeout_s": 180
    },
    {
      "id": "mistral-large-3",
      "via": "router",
      "expect_served_by": "mistral-large-3",
      "batch_sentences": 30,
      "max_tokens": 6500,
      "min_interval_s": 0,
      "timeout_s": 180
    },
    {
      "id": "gemma-4-31b-it",
      "via": "router",
      "expect_served_by": "gemma-4-31b",
      "batch_sentences": 18,
      "max_tokens": 4500,
      "min_interval_s": 0,
      "timeout_s": 240
    },
    {
      "id": "gemini-3.5-flash-lite",
      "via": "google",
      "key_file": "~/.secrets/gemini_paid_api_key.txt",
      "batch_sentences": 30,
      "max_tokens": 8000,
      "min_interval_s": 0,
      "timeout_s": 120
    }
  ],

  "retries_per_batch": 3,
  "backoff_seconds": [5, 20, 60],
  "max_wait_on_429_s": 90,
  "cooldown_after_exhaustion_s": 900,
  "max_idioms_per_batch": 12
}
