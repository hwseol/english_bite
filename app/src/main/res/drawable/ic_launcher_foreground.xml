    <!-- "Bite" mark: a circle with a bite taken out of the upper-right, chosen over a
         speech-bubble/letter/play-triangle version (too close to a video-app play button,
         reads as a knockoff of YouTube's mark). The bite is a true hole (evenOdd over both
         subpaths) rather than a shape painted in the background's own color, so it reads
         correctly against the background gradient below instead of showing a flat patch. -->
    <path
        android:fillColor="#2F7DFF"
        android:fillType="evenOdd"
        android:pathData="M54,20 A34,34 0 1,0 54,88 A34,34 0 1,0 54,20 Z
                           M76,21 A15,15 0 1,0 76,51 A15,15 0 1,0 76,21 Z" />
    <!-- Two subtitle bars (the bilingual-subtitle feature is the app's actual
         differentiator, not "plays video" - every video app has a play button) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,48 L59,48 A3,3 0 0 1 62,51 A3,3 0 0 1 59,54 L39,54
                           A3,3 0 0 1 36,51 A3,3 0 0 1 39,48 Z
                           M39,59 L51,59 A3,3 0 0 1 54,62 A3,3 0 0 1 51,65 L39,65
                           A3,3 0 0 1 36,62 A3,3 0 0 1 39,59 Z" />
</vector>
