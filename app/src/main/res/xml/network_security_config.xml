<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev-only: allow plaintext HTTP to the local backend running on the host machine,
         reached via "adb reverse tcp:8000 tcp:8000" (works for emulator and real device
         alike) or, as a fallback, the emulator's 10.0.2.2 loopback alias. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- The EC2 backend - plain HTTP for now since there's no domain name yet to get a real
         TLS cert for (just the instance's own public IP). Fine for now; revisit once/if this
         gets a domain. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">13.218.170.114</domain>
    </domain-config>
</network-security-config>
